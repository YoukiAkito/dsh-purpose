{
  "name": "muri-purpose",
  "version": "0.1.0",
  "description": "Purpose-driven proactive outreach for DeepSeek Harness: collect materials, form goal hypotheses, score them, deliver at most one, and learn from the reply. muri-purpose：给 DSH agent 装上『目的机制』——收集素材、提出目标假设、打分选一条、投递后按反馈调整权重。零依赖，macOS 优先，Linux 可用，Windows 暂未实现。",
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test test/",
    "lint": "node --check src/index.js"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "proactive",
    "autonomy",
    "goal",
    "agent",
    "purpose",
    "主动",
    "自主决策",
    "目的机制"
  ],
  "license": "GPL-2.0-only",
  "engines": {
    "node": ">=22.5"
  },
  "os": [
    "darwin",
    "linux",
    "!win32"
  ],
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@deepseek-ai/dsh-agent": "^0.2.0-rc.1 || ^0.2.1-rc.2",
    "@deepseek-ai/dsh-tools": "^0.2.0-rc.1 || ^0.2.1-rc.2",
    "@deepseek-ai/dsh-session": "^0.2.0-rc.1 || ^0.2.1-rc.2",
    "@deepseek-ai/dsh-session-persistence": "^0.2.0-rc.1 || ^0.2.1-rc.2"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-session": {
      "optional": true
    },
    "@deepseek-ai/dsh-session-persistence": {
      "optional": true
    }
  }
}
